	file = {PDF:C\:\\Users\\steph\\Zotero\\storage\\2KKCS9ZI\\Pinon et al. - 2023 - One-Class SVM on siamese neural network latent space for Unsupervised Anomaly Detection on brain MRI.pdf:application/pdf},
}

@article{maitra_real-time_nodate,
	title = {A {Real}-time {Anomaly} {Detection} {Using} {Convolutional} {Autoencoder} with {Dynamic} {Threshold}},
	abstract = {The majority of modern consumer-level energy is generated by real-time smart metering systems. These frequently contain anomalies, which prevent reliable estimates of the series' evolution. This work introduces a hybrid modeling approach combining statistics and a Convolutional Autoencoder with a dynamic threshold. The threshold is determined based on Mahalanobis distance and moving averages. It has been tested using real-life energy consumption data collected from smart metering systems. The solution includes a real-time, meter-level anomaly detection system that connects to an advanced monitoring system. This makes a substantial contribution by detecting unusual data movements and delivering an early warning. Early detection and subsequent troubleshooting can financially benefit organizations and consumers and prevent disasters from occurring.},
	language = {en},
	author = {Maitra, Sarit and Kundu, Sukanya and Shankar, Aishwarya},
	file = {PDF:C\:\\Users\\steph\\Zotero\\storage\\5L9VTIME\\Maitra et al. - A Real-time Anomaly Detection Using Convolutional Autoencoder with Dynamic Threshold.pdf:application/pdf},
}

@article{arslan_rankbased_2026,
	title = {A {Rank}‐{Based} {CUSUM} {Monitoring} {Scheme} for {Time} {Between} {Events} and {Amplitude} {Data}},
	issn = {0748-8017, 1099-1638},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/qre.70367},
	doi = {10.1002/qre.70367},
	abstract = {Monitoring time between events and amplitude (TBEA) data is critical in many applications, particularly in manufacturing, reliability engineering, and service operations. Yet, most existing TBEA control charts focus on a single quality characteristic and are typically developed under restrictive distributional assumptions. In practice, each event is characterized by two independent variables: the waiting time since the previous event and the magnitude (amplitude) of the event itself, whose underlying distributions are often unknown. This paper proposes a novel rank-based one-sided cumulative sum (CUSUM) control chart for univariate TBEA monitoring, designed to jointly monitor shifts in both the interarrival time and the amplitude. The runlength properties of the proposed nonparametric CUSUM-TBEA chart are derived via a Markov chain approximation, enabling computation of in-control (IC) and out-of-control (OOC) performance measures using closed-form expressions. Monte Carlo simulations confirm the accuracy of the Markov chain results and provide guidance on the required simulation size for reliable performance estimation. Under identical IC conditions, the proposed CUSUM–TBEA chart generally exhibits faster detection and reduced run-length variability compared to the classical exponentially weighted moving average (EWMA) chart, particularly for moderate to large shifts. The effects of Phase I sample size, unknown shift magnitudes, and correlation are also investigated. The results reveal robust performance across a wide range of monitoring scenarios. An illustrative example involving wildfire occurrence data further highlights the practical applicability of the proposed method. Overall, the results show that the proposed chart is a powerful distribution-free and a practical tool for monitoring event-driven processes with concurrent changes in event timing and magnitude.},
	language = {en},
	urldate = {2026-09-06},
	journal = {Quality and Reliability Engineering International},
	author = {Arslan, Muhammad and Yeganeh, Ali and Sogandi, Fatemeh and Malela‐Majika, Jean‐Claude and Figueiredo, Fernanda Otilia and Iqbal, Aisha},
	month = aug,
	year = {2026},
	note = {doi:10.1002/qre.70367},
	file = {PDF:C\:\\Users\\steph\\Zotero\\storage\\T9JFS3EB\\Arslan et al. - 2026 - A Rank‐Based CUSUM Monitoring Scheme for Time Between Events and Amplitude Data.pdf:application/pdf},
}

